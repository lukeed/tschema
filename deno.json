{
	"version": "3.2.0",
	"tasks": {
		"build": "deno run -A scripts/build.ts",
		"release": "deno run -A scripts/release.ts"
	},
	"lint": {
		"rules": {
			"exclude": [
				"no-var",
				"prefer-const",
				"no-cond-assign",
				"no-inner-declarations"
			]
		}
	},
	"fmt": {
		"lineWidth": 100,
		"singleQuote": true,
		"useTabs": true
	},
	"exclude": [
		"coverage",
		"readme.md",
		"npm",
		"suite"
	],
	"imports": {
		"@sinclair/typebox": "npm:@sinclair/typebox@^0.32",
		"@std/assert": "jsr:@std/assert@^1.0",
		"@std/path": "jsr:@std/path@^1.0",
		"@std/testing": "jsr:@std/testing@^1.0",
		"oxc-transform": "npm:oxc-transform@^0.23",
		"zod": "npm:zod@^3.23",
		"zod-to-json-schema": "npm:zod-to-json-schema@^3.23"
	}
}
