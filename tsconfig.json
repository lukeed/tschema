{
	"compilerOptions": {
		"target": "esnext",
		"module": "preserve",
		"moduleResolution": "bundler",
		"lib": ["esnext"],
		"types": ["bun"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"isolatedDeclarations": true,
		"declaration": true,
		"verbatimModuleSyntax": true
	},
	"include": ["*.ts", "scripts", "bench"],
	"exclude": ["npm", "jsr", "suite", "node_modules"]
}
